    {
      "id": 15,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Warnings and errors",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"piqueld\"} | detected_level=~\"warn|error\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "description": "The daemon's own warnings and failed history events.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
