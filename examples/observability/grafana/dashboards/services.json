{
  "uid": "piqueld-services",
  "title": "piqueld services",
  "description": "Replicas and container resource usage of every deployed service.",
  "tags": [
    "piqueld"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(piqueld_service_replicas, application)",
        "definition": "label_values(piqueld_service_replicas, application)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(piqueld_service_replicas{application=~\"$application\"}, environment)",
        "definition": "label_values(piqueld_service_replicas{application=~\"$application\"}, environment)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\"}, service)",
        "definition": "label_values(piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\"}, service)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"desired\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services below desired replicas",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"desired\"} - ignoring(state) piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"healthy\"}) > 0) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_cpu_usage{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "description": "CPUs in use; 1 is one full core.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_memory_usage_bytes{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Replicas",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"desired\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"running\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"healthy\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "state": true
            },
            "indexByName": {
              "application": 0,
              "environment": 1,
              "service": 2
            },
            "renameByName": {
              "Value #A": "Desired",
              "Value #B": "Running",
              "Value #C": "Healthy"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Healthy replicas",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "piqueld_service_replicas{application=~\"$application\", environment=~\"$environment\", service=~\"$service\", state=\"healthy\"}",
          "legendFormat": "{{application}}/{{environment}}/{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Containers",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (piqueld_application, piqueld_environment, job) (container_cpu_usage{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\"})",
          "legendFormat": "{{piqueld_application}}/{{piqueld_environment}}/{{job}}",
          "refId": "A"
        }
      ],
      "description": "CPUs used; 1 is one full core.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (piqueld_application, piqueld_environment, job) (container_memory_usage_bytes{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\"})",
          "legendFormat": "{{piqueld_application}}/{{piqueld_environment}}/{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memory of its limit",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (piqueld_application, piqueld_environment, job) (container_memory_usage_bytes{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\"} / container_memory_usage_limit_bytes{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\"})",
          "legendFormat": "{{piqueld_application}}/{{piqueld_environment}}/{{job}}",
          "refId": "A"
        }
      ],
      "description": "The host's memory for containers without a limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (piqueld_application, piqueld_environment, job) (rate(container_network_io_bytes_total{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\", network_io_direction=\"receive\"}[$__rate_interval]))",
          "legendFormat": "{{piqueld_application}}/{{piqueld_environment}}/{{job}} received",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-sum by (piqueld_application, piqueld_environment, job) (rate(container_network_io_bytes_total{piqueld_workload=\"service\", piqueld_application=~\"$application\", piqueld_environment=~\"$environment\", job=~\"$service\", network_io_direction=\"transmit\"}[$__rate_interval]))",
          "legendFormat": "{{piqueld_application}}/{{piqueld_environment}}/{{job}} sent",
          "refId": "B"
        }
      ],
      "description": "Sent bytes are negative.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Ingress",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Ingress CPU",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (container_cpu_usage{piqueld_workload=\"infrastructure\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "description": "The gateway, the apps tailnet node and cloudflared.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Ingress memory",
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (container_memory_usage_bytes{piqueld_workload=\"infrastructure\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
