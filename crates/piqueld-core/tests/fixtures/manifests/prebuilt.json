{
  "api_version": "piqueld.dev/v1alpha1",
  "kind": "Application",
  "metadata": { "name": "notes" },
  "spec": {
    "services": [{
      "name": "web",
      "source": { "type": "image", "image": "ghcr.io/example/notes:1.4.0" },
      "mounts": [{ "volume": "data", "target": "/var/lib/notes" }]
    }],
    "volumes": [{ "name": "data" }]
  }
}
