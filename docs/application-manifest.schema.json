{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ApplicationSpec": {
      "additionalProperties": false,
      "description": "User-provided application resource lists.",
      "properties": {
        "environments": {
          "additionalProperties": {
            "$ref": "#/definitions/EnvironmentConfig"
          },
          "default": {},
          "description": "Configuration for each environment, selected by environment name.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "jobs": {
          "default": [],
          "description": "One-shot jobs, run in declared order at their deployment point.",
          "items": {
            "$ref": "#/definitions/Job"
          },
          "type": "array"
        },
        "manifest": {
          "default": null,
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/RepositoryManifest",
              "description": "Optional repository that supplies this application's manifest on Deploy."
            }
          ]
        },
        "previews": {
          "default": {
            "visibility": "private"
          },
          "oneOf": [
            {
              "$ref": "#/definitions/PreviewConfig",
              "description": "Configuration shared by every preview."
            }
          ]
        },
        "routes": {
          "default": [],
          "description": "Exact-hostname HTTP routes, activated on deployment.",
          "items": {
            "$ref": "#/definitions/Route"
          },
          "type": "array"
        },
        "secrets": {
          "default": [],
          "description": "Application secrets whose values piqueld generates once.",
          "items": {
            "$ref": "#/definitions/SecretDeclaration"
          },
          "type": "array"
        },
        "services": {
          "default": [],
          "description": "Declared services.",
          "items": {
            "$ref": "#/definitions/Service"
          },
          "type": "array"
        },
        "variables": {
          "additionalProperties": {
            "$ref": "#/definitions/Variable"
          },
          "default": {},
          "description": "Default values of variables referenced as `${{ vars.<name> }}`, used by\nenvironments that set no value of their own.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "volumes": {
          "default": [],
          "description": "Declared named volumes.",
          "items": {
            "$ref": "#/definitions/Volume"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Build": {
      "description": "Explicit build backend, extensible independently from source selection.",
      "oneOf": [
        {
          "description": "Build a local container image using Docker.",
          "properties": {
            "args": {
              "additionalProperties": {
                "$ref": "#/definitions/Template"
              },
              "description": "Values passed as `--build-arg`. They are recorded in image\nmetadata, so sensitive values belong in secrets instead.",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "context": {
              "$ref": "#/definitions/Template",
              "description": "Build context relative to the repository root."
            },
            "dockerfile": {
              "$ref": "#/definitions/Template",
              "description": "Dockerfile path relative to the repository root."
            },
            "target": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/Template",
                  "description": "Multi-stage build target; the final stage when absent."
                }
              ]
            },
            "type": {
              "enum": [
                "docker"
              ],
              "type": "string"
            }
          },
          "required": [
            "dockerfile",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentConfig": {
      "additionalProperties": false,
      "description": "Configuration of one environment, `[spec.environments.<name>]`.",
      "properties": {
        "variables": {
          "additionalProperties": {
            "$ref": "#/definitions/Variable"
          },
          "default": {},
          "description": "This environment's values: each overrides the `[spec.variables]` default\nof the same name, or declares a variable without a default.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "visibility": {
          "default": "public",
          "oneOf": [
            {
              "$ref": "#/definitions/Visibility",
              "description": "The strictest visibility this environment's routes get. The default,\n`public`, restricts nothing; `private` keeps every route on the tailnet."
            }
          ]
        }
      },
      "type": "object"
    },
    "GitRepository": {
      "additionalProperties": false,
      "description": "Git checkout configuration. Credentials come from the host's Git configuration.",
      "properties": {
        "branch": {
          "description": "Branch to fetch when no commit is pinned.",
          "type": "string"
        },
        "commit": {
          "description": "Optional full commit hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Git clone URL or local repository path.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "branch"
      ],
      "type": "object"
    },
    "HealthCheck": {
      "description": "User-declared container health check.",
      "oneOf": [
        {
          "description": "HTTP health endpoint check.",
          "properties": {
            "interval_seconds": {
              "$ref": "#/definitions/Typed_u32",
              "description": "Probe interval in seconds."
            },
            "path": {
              "$ref": "#/definitions/Template",
              "description": "HTTP path to probe."
            },
            "port": {
              "$ref": "#/definitions/Typed_u16",
              "description": "Container port to probe."
            },
            "timeout_seconds": {
              "$ref": "#/definitions/Typed_u32",
              "description": "Probe timeout in seconds."
            },
            "type": {
              "enum": [
                "http"
              ],
              "type": "string"
            }
          },
          "required": [
            "port",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Executable command health check.",
          "properties": {
            "command": {
              "description": "Command and arguments to execute.",
              "items": {
                "$ref": "#/definitions/Template"
              },
              "type": "array"
            },
            "interval_seconds": {
              "$ref": "#/definitions/Typed_u32",
              "description": "Probe interval in seconds."
            },
            "timeout_seconds": {
              "$ref": "#/definitions/Typed_u32",
              "description": "Probe timeout in seconds."
            },
            "type": {
              "enum": [
                "command"
              ],
              "type": "string"
            }
          },
          "required": [
            "command",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Job": {
      "additionalProperties": false,
      "description": "A container that runs to completion at a defined point in each deployment.",
      "properties": {
        "command": {
          "description": "Command replacing the service's command and arguments.",
          "items": {
            "$ref": "#/definitions/Template"
          },
          "type": "array"
        },
        "name": {
          "description": "Logical job name.",
          "type": "string"
        },
        "run": {
          "$ref": "#/definitions/JobRun",
          "description": "Deployment point at which the job runs."
        },
        "service": {
          "description": "Service whose prepared image, environment, secrets, and mounts the job reuses.",
          "type": "string"
        },
        "timeout_seconds": {
          "description": "Seconds the job may run before the deployment fails.",
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "service",
        "command",
        "run"
      ],
      "type": "object"
    },
    "JobRun": {
      "description": "Deployment point at which a job runs.",
      "enum": [
        "before-rollout"
      ],
      "type": "string"
    },
    "ManifestRepository": {
      "description": "The literal `\"self\"`, selecting the manifest's own repository.",
      "enum": [
        "self"
      ],
      "type": "string"
    },
    "Metadata": {
      "additionalProperties": false,
      "description": "User-provided application metadata.",
      "properties": {
        "name": {
          "description": "User-facing application name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Mount": {
      "additionalProperties": false,
      "description": "A persistent volume mount in a service.",
      "properties": {
        "read_only": {
          "description": "Whether the mount is read-only.",
          "type": "boolean"
        },
        "target": {
          "description": "Container target path.",
          "type": "string"
        },
        "volume": {
          "description": "Referenced logical volume name.",
          "type": "string"
        }
      },
      "required": [
        "volume",
        "target"
      ],
      "type": "object"
    },
    "PreviewConfig": {
      "additionalProperties": false,
      "description": "Configuration shared by previews, `[spec.previews]`.",
      "properties": {
        "visibility": {
          "default": "private",
          "oneOf": [
            {
              "$ref": "#/definitions/Visibility",
              "description": "The strictest visibility preview routes get; `private` by default, so\npreviews publish routes only with an explicit `public`."
            }
          ]
        }
      },
      "type": "object"
    },
    "Redirect": {
      "additionalProperties": false,
      "description": "Redirect route input.",
      "properties": {
        "preserve_path": {
          "description": "Appends the request path and query to `to`.",
          "type": "boolean"
        },
        "status": {
          "description": "301, 302, 303, 307, or 308.",
          "format": "int32",
          "maximum": 308,
          "minimum": 301,
          "type": "integer"
        },
        "to": {
          "$ref": "#/definitions/Template",
          "description": "Absolute `http` or `https` destination URL."
        }
      },
      "required": [
        "to"
      ],
      "type": "object"
    },
    "RepositoryManifest": {
      "additionalProperties": false,
      "description": "Independently selects the manifest used by a manual deployment.",
      "properties": {
        "path": {
          "description": "Exact TOML or JSON file path relative to the repository root.",
          "type": "string"
        },
        "repository": {
          "$ref": "#/definitions/GitRepository",
          "description": "Repository and revision containing the manifest."
        }
      },
      "required": [
        "repository",
        "path"
      ],
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "description": "Optional CPU and memory limits for a service.",
      "properties": {
        "cpu_millis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Typed_u32",
              "description": "CPU limit in millicores."
            }
          ]
        },
        "memory_bytes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Typed_u64",
              "description": "Memory limit in bytes."
            }
          ]
        }
      },
      "type": "object"
    },
    "Rollout": {
      "additionalProperties": false,
      "description": "Optional `rollout` block of a service. Omitted fields keep their defaults,\nso an empty block is equivalent to no block.",
      "properties": {
        "monitor_seconds": {
          "default": null,
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Typed_u32",
              "description": "Seconds Docker watches each replacement task for failure; 30 when omitted."
            }
          ]
        },
        "order": {
          "default": null,
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Typed_RolloutOrder",
              "description": "Update order; derived from the service's mounts when omitted."
            }
          ]
        }
      },
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "HTTP route input, validated independently of ingress enablement.\nA route sets either `service` and `port`, or `redirect`.",
      "properties": {
        "hostname": {
          "$ref": "#/definitions/Template",
          "description": "Exact public DNS hostname."
        },
        "port": {
          "description": "Internal HTTP backend port.",
          "format": "int32",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "redirect": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Redirect",
              "description": "Redirect answered by the gateway instead of a service."
            }
          ]
        },
        "service": {
          "description": "Logical service in this application.",
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "$ref": "#/definitions/Visibility",
          "description": "Who may connect; `private` (tailnet only) by default. Its environment's\nceiling can make it stricter, never looser."
        }
      },
      "required": [
        "hostname"
      ],
      "type": "object"
    },
    "SecretDeclaration": {
      "additionalProperties": false,
      "description": "An application secret whose value piqueld generates when a deployment first\nneeds it. A stored value, generated or set manually, is never replaced.",
      "properties": {
        "generate": {
          "$ref": "#/definitions/SecretGenerator",
          "description": "How the value is generated."
        },
        "name": {
          "description": "Application-scoped logical secret name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "generate"
      ],
      "type": "object"
    },
    "SecretEncoding": {
      "description": "Text encoding of generated random bytes.",
      "enum": [
        "hex",
        "base64url"
      ],
      "type": "string"
    },
    "SecretGenerator": {
      "description": "The exhaustive set of secret value generators.",
      "oneOf": [
        {
          "description": "Random bytes from the operating system, encoded as text.",
          "properties": {
            "bytes": {
              "description": "Number of random bytes before encoding.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "encoding": {
              "$ref": "#/definitions/SecretEncoding",
              "description": "Text encoding of the random bytes."
            },
            "type": {
              "enum": [
                "random"
              ],
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "RSA private key in PKCS#8 PEM.",
          "properties": {
            "bits": {
              "description": "Modulus size in bits.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "rsa"
              ],
              "type": "string"
            }
          },
          "required": [
            "bits",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SecretMount": {
      "additionalProperties": false,
      "description": "A logical application secret exposed only as a container file.",
      "properties": {
        "name": {
          "description": "Application-scoped logical secret name.",
          "type": "string"
        },
        "target": {
          "description": "Absolute normalized destination under /run/secrets.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "target"
      ],
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "description": "User-declared application service.",
      "properties": {
        "arguments": {
          "description": "Arguments passed to the command.",
          "items": {
            "$ref": "#/definitions/Template"
          },
          "type": "array"
        },
        "command": {
          "description": "Container entrypoint command.",
          "items": {
            "$ref": "#/definitions/Template"
          },
          "type": "array"
        },
        "depends_on": {
          "description": "Services in this application that must be healthy before this one rolls out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/definitions/Template"
          },
          "description": "Environment variables keyed by name.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "healthcheck": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/HealthCheck",
              "description": "Optional container health check."
            }
          ]
        },
        "mounts": {
          "description": "Persistent volume mounts.",
          "items": {
            "$ref": "#/definitions/Mount"
          },
          "type": "array"
        },
        "name": {
          "description": "Logical service name.",
          "type": "string"
        },
        "replicas": {
          "$ref": "#/definitions/Typed_u16",
          "description": "Desired replica count."
        },
        "resources": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ResourceLimits",
              "description": "Optional CPU and memory limits."
            }
          ]
        },
        "rollout": {
          "$ref": "#/definitions/Rollout",
          "description": "Optional rollout order and monitor window."
        },
        "secrets": {
          "description": "Application-scoped secrets mounted as files.",
          "items": {
            "$ref": "#/definitions/SecretMount"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/definitions/Source",
          "description": "Explicit image or build source."
        }
      },
      "required": [
        "name",
        "source"
      ],
      "type": "object"
    },
    "Source": {
      "description": "The exhaustive set of deployable service sources.",
      "oneOf": [
        {
          "description": "Pull a prebuilt image from a registry.",
          "properties": {
            "image": {
              "$ref": "#/definitions/Template",
              "description": "Image reference."
            },
            "type": {
              "enum": [
                "image"
              ],
              "type": "string"
            }
          },
          "required": [
            "image",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Build a checked-out Git revision.",
          "properties": {
            "build": {
              "$ref": "#/definitions/Build",
              "description": "Explicit build instructions."
            },
            "repository": {
              "$ref": "#/definitions/SourceRepository",
              "description": "Repository and revision to resolve."
            },
            "type": {
              "enum": [
                "git"
              ],
              "type": "string"
            }
          },
          "required": [
            "repository",
            "build",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SourceRepository": {
      "description": "The repository a Git build source checks out.",
      "oneOf": [
        {
          "$ref": "#/definitions/ManifestRepository",
          "description": "`\"self\"`: the application's manifest repository, at the exact commit its\nmanifest was read from, so one deployment builds from one revision."
        },
        {
          "$ref": "#/definitions/GitRepository",
          "description": "An independently resolved repository and revision."
        }
      ]
    },
    "Template": {
      "description": "Text that may contain `${{ namespace.name }}` references, with optional\nwhitespace inside the braces. `$${{` writes a literal `${{`; `${VAR}` and\n`$VAR` are ordinary text, left for shells and applications to expand.\n\n```text\n\"${{ vars.domain }}\"       -> the value of `domain`\n\"api.${{vars.domain}}\"     -> \"api.\" followed by the value of `domain`\n\"$${{ vars.domain }}\"      -> \"${{ vars.domain }}\", literally\n```",
      "type": "string"
    },
    "TypedTemplate": {
      "description": "Schema of a template in a typed field: text containing `${{`.",
      "pattern": "\\$\\{\\{",
      "type": "string"
    },
    "Typed_RolloutOrder": {
      "description": "A typed value: a literal, or a template rendered for each environment.\n\nA template that is exactly one reference yields the variable's own value;\nany other template yields text. The result must then decode as `T`, so\nstrings are never parsed into numbers.",
      "oneOf": [
        {
          "description": "Whether Docker stops a task before or after starting its replacement.",
          "enum": [
            "stop-first",
            "start-first"
          ],
          "type": "string"
        },
        {
          "$ref": "#/definitions/TypedTemplate",
          "description": "A value rendered from variables."
        }
      ]
    },
    "Typed_u16": {
      "description": "A typed value: a literal, or a template rendered for each environment.\n\nA template that is exactly one reference yields the variable's own value;\nany other template yields text. The result must then decode as `T`, so\nstrings are never parsed into numbers.",
      "oneOf": [
        {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "$ref": "#/definitions/TypedTemplate",
          "description": "A value rendered from variables."
        }
      ]
    },
    "Typed_u32": {
      "description": "A typed value: a literal, or a template rendered for each environment.\n\nA template that is exactly one reference yields the variable's own value;\nany other template yields text. The result must then decode as `T`, so\nstrings are never parsed into numbers.",
      "oneOf": [
        {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "$ref": "#/definitions/TypedTemplate",
          "description": "A value rendered from variables."
        }
      ]
    },
    "Typed_u64": {
      "description": "A typed value: a literal, or a template rendered for each environment.\n\nA template that is exactly one reference yields the variable's own value;\nany other template yields text. The result must then decode as `T`, so\nstrings are never parsed into numbers.",
      "oneOf": [
        {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        {
          "$ref": "#/definitions/TypedTemplate",
          "description": "A value rendered from variables."
        }
      ]
    },
    "Variable": {
      "description": "A declared variable value: a string, integer, or boolean. Strings may\nreference system variables, but not other variables.",
      "oneOf": [
        {
          "description": "A boolean.",
          "type": "boolean"
        },
        {
          "description": "A signed 64-bit integer.",
          "format": "int64",
          "type": "integer"
        },
        {
          "$ref": "#/definitions/Template",
          "description": "Text, which may reference system variables."
        }
      ]
    },
    "Visibility": {
      "description": "Who may connect to a route: everyone, or only tailnet devices. It says\nnothing about how traffic arrives; the installation decides that.\n\nVariants are ordered from least to most restrictive, so the stricter of\ntwo visibilities is their maximum.",
      "enum": [
        "public",
        "private"
      ],
      "type": "string"
    },
    "Volume": {
      "additionalProperties": false,
      "description": "User-declared named volume.",
      "properties": {
        "name": {
          "description": "Logical volume name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Strict public application manifest request and export shape.",
  "properties": {
    "api_version": {
      "const": "piqueld.dev/v1alpha1",
      "description": "API version string.",
      "type": "string"
    },
    "kind": {
      "const": "Application",
      "description": "Resource kind string.",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/definitions/Metadata",
      "description": "User-provided metadata."
    },
    "spec": {
      "$ref": "#/definitions/ApplicationSpec",
      "description": "Desired application resources."
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "piqueld application manifest",
  "type": "object"
}
