{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ApplicationSpec": {
      "additionalProperties": false,
      "description": "User-provided application resource lists.",
      "properties": {
        "manifest": {
          "default": null,
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/RepositoryManifest",
              "description": "Optional repository that supplies this application's manifest on Deploy."
            }
          ]
        },
        "routes": {
          "default": [],
          "description": "Exact public HTTP routes, activated on deployment.",
          "items": {
            "$ref": "#/definitions/Route"
          },
          "type": "array"
        },
        "secrets": {
          "default": [],
          "description": "Application secrets whose values piqueld generates once.",
          "items": {
            "$ref": "#/definitions/SecretDeclaration"
          },
          "type": "array"
        },
        "services": {
          "default": [],
          "description": "Declared services.",
          "items": {
            "$ref": "#/definitions/Service"
          },
          "type": "array"
        },
        "volumes": {
          "default": [],
          "description": "Declared named volumes.",
          "items": {
            "$ref": "#/definitions/Volume"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Build": {
      "description": "Explicit build backend, extensible independently from source selection.",
      "oneOf": [
        {
          "description": "Build a local container image using Docker.",
          "properties": {
            "context": {
              "description": "Build context relative to the repository root.",
              "type": "string"
            },
            "dockerfile": {
              "description": "Dockerfile path relative to the repository root.",
              "type": "string"
            },
            "type": {
              "enum": [
                "docker"
              ],
              "type": "string"
            }
          },
          "required": [
            "dockerfile",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "GitRepository": {
      "additionalProperties": false,
      "description": "Git checkout configuration. Credentials come from the host's Git configuration.",
      "properties": {
        "branch": {
          "description": "Branch to fetch when no commit is pinned.",
          "type": "string"
        },
        "commit": {
          "description": "Optional full commit hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Git clone URL or local repository path.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "branch"
      ],
      "type": "object"
    },
    "HealthCheck": {
      "description": "User-declared container health check.",
      "oneOf": [
        {
          "description": "HTTP health endpoint check.",
          "properties": {
            "interval_seconds": {
              "description": "Probe interval in seconds.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "description": "HTTP path to probe.",
              "type": "string"
            },
            "port": {
              "description": "Container port to probe.",
              "format": "int32",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "timeout_seconds": {
              "description": "Probe timeout in seconds.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "http"
              ],
              "type": "string"
            }
          },
          "required": [
            "port",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Executable command health check.",
          "properties": {
            "command": {
              "description": "Command and arguments to execute.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "interval_seconds": {
              "description": "Probe interval in seconds.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "timeout_seconds": {
              "description": "Probe timeout in seconds.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "command"
              ],
              "type": "string"
            }
          },
          "required": [
            "command",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Metadata": {
      "additionalProperties": false,
      "description": "User-provided application metadata.",
      "properties": {
        "name": {
          "description": "User-facing application name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Mount": {
      "additionalProperties": false,
      "description": "A persistent volume mount in a service.",
      "properties": {
        "read_only": {
          "description": "Whether the mount is read-only.",
          "type": "boolean"
        },
        "target": {
          "description": "Container target path.",
          "type": "string"
        },
        "volume": {
          "description": "Referenced logical volume name.",
          "type": "string"
        }
      },
      "required": [
        "volume",
        "target"
      ],
      "type": "object"
    },
    "Redirect": {
      "additionalProperties": false,
      "description": "Redirect route input.",
      "properties": {
        "preserve_path": {
          "description": "Appends the request path and query to `to`.",
          "type": "boolean"
        },
        "status": {
          "description": "301, 302, 303, 307, or 308.",
          "format": "int32",
          "maximum": 308,
          "minimum": 301,
          "type": "integer"
        },
        "to": {
          "description": "Absolute `http` or `https` destination URL.",
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "type": "object"
    },
    "RepositoryManifest": {
      "additionalProperties": false,
      "description": "Independently selects the manifest used by a manual deployment.",
      "properties": {
        "path": {
          "description": "Exact TOML or JSON file path relative to the repository root.",
          "type": "string"
        },
        "repository": {
          "$ref": "#/definitions/GitRepository",
          "description": "Repository and revision containing the manifest."
        }
      },
      "required": [
        "repository",
        "path"
      ],
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "description": "Optional CPU and memory limits for a service.",
      "properties": {
        "cpu_millis": {
          "description": "CPU limit in millicores.",
          "format": "int32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_bytes": {
          "description": "Memory limit in bytes.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "Public HTTP route input, validated independently of ingress enablement.\nA route sets either `service` and `port`, or `redirect`.",
      "properties": {
        "hostname": {
          "description": "Exact public DNS hostname.",
          "type": "string"
        },
        "port": {
          "description": "Internal HTTP backend port.",
          "format": "int32",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "redirect": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Redirect",
              "description": "Redirect answered by the gateway instead of a service."
            }
          ]
        },
        "service": {
          "description": "Logical service in this application.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hostname"
      ],
      "type": "object"
    },
    "SecretDeclaration": {
      "additionalProperties": false,
      "description": "An application secret whose value piqueld generates when a deployment first\nneeds it. A stored value, generated or set manually, is never replaced.",
      "properties": {
        "generate": {
          "$ref": "#/definitions/SecretGenerator",
          "description": "How the value is generated."
        },
        "name": {
          "description": "Application-scoped logical secret name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "generate"
      ],
      "type": "object"
    },
    "SecretEncoding": {
      "description": "Text encoding of generated random bytes.",
      "enum": [
        "hex",
        "base64url"
      ],
      "type": "string"
    },
    "SecretGenerator": {
      "description": "The exhaustive set of secret value generators.",
      "oneOf": [
        {
          "description": "Random bytes from the operating system, encoded as text.",
          "properties": {
            "bytes": {
              "description": "Number of random bytes before encoding.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "encoding": {
              "$ref": "#/definitions/SecretEncoding",
              "description": "Text encoding of the random bytes."
            },
            "type": {
              "enum": [
                "random"
              ],
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "RSA private key in PKCS#8 PEM.",
          "properties": {
            "bits": {
              "description": "Modulus size in bits.",
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "rsa"
              ],
              "type": "string"
            }
          },
          "required": [
            "bits",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SecretMount": {
      "additionalProperties": false,
      "description": "A logical application secret exposed only as a container file.",
      "properties": {
        "name": {
          "description": "Application-scoped logical secret name.",
          "type": "string"
        },
        "target": {
          "description": "Absolute normalized destination under /run/secrets.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "target"
      ],
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "description": "User-declared application service.",
      "properties": {
        "arguments": {
          "description": "Arguments passed to the command.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "description": "Container entrypoint command.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables keyed by name.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "healthcheck": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/HealthCheck",
              "description": "Optional container health check."
            }
          ]
        },
        "mounts": {
          "description": "Persistent volume mounts.",
          "items": {
            "$ref": "#/definitions/Mount"
          },
          "type": "array"
        },
        "name": {
          "description": "Logical service name.",
          "type": "string"
        },
        "replicas": {
          "description": "Desired replica count.",
          "format": "int32",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "resources": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ResourceLimits",
              "description": "Optional CPU and memory limits."
            }
          ]
        },
        "secrets": {
          "description": "Application-scoped secrets mounted as files.",
          "items": {
            "$ref": "#/definitions/SecretMount"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/definitions/Source",
          "description": "Explicit image or build source."
        }
      },
      "required": [
        "name",
        "source"
      ],
      "type": "object"
    },
    "Source": {
      "description": "The exhaustive set of deployable service sources.",
      "oneOf": [
        {
          "description": "Pull a prebuilt image from a registry.",
          "properties": {
            "image": {
              "description": "Image reference.",
              "type": "string"
            },
            "type": {
              "enum": [
                "image"
              ],
              "type": "string"
            }
          },
          "required": [
            "image",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Build a checked-out Git revision.",
          "properties": {
            "build": {
              "$ref": "#/definitions/Build",
              "description": "Explicit build instructions."
            },
            "repository": {
              "$ref": "#/definitions/GitRepository",
              "description": "Repository and revision to resolve."
            },
            "type": {
              "enum": [
                "git"
              ],
              "type": "string"
            }
          },
          "required": [
            "repository",
            "build",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Volume": {
      "additionalProperties": false,
      "description": "User-declared named volume.",
      "properties": {
        "name": {
          "description": "Logical volume name.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Strict public application manifest request and export shape.",
  "properties": {
    "api_version": {
      "const": "piqueld.dev/v1alpha1",
      "description": "API version string.",
      "type": "string"
    },
    "kind": {
      "const": "Application",
      "description": "Resource kind string.",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/definitions/Metadata",
      "description": "User-provided metadata."
    },
    "spec": {
      "$ref": "#/definitions/ApplicationSpec",
      "description": "Desired application resources."
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "piqueld application manifest",
  "type": "object"
}
